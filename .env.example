# Copier dans .env puis renseigner les identifiants PostgreSQL localement.
# Le fichier .env est ignoré par Git ; ne jamais publier de vrais identifiants.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB="sma signalement"
POSTGRES_USER=
POSTGRES_PASSWORD=
WEB_PORT=8080
API_PORT=8081
# Analyse réelle : définir AI_MODE=hosted et renseigner la clé côté serveur.
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
AI_MODE=disabled
