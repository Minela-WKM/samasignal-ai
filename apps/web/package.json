  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-vue": "6.0.10",
    "axe-core": "4.14.0",
    "tailwindcss": "4.3.3",
    "vite": "8.3.4"
  }
}
